# Luna interceptor — optional ENVIRONMENT OVERRIDES
# Prefer JSON: ./luna.config.json or ~/.config/luna/config.json (see ../luna.config.json)
# Or copy to ./.env in the project root (loaded automatically from $CWD).
# Process env wins over .env; .env wins over JSON. See docs/oob-approval.md
#
#   set -a && source env.example && set +a

# export LUNA_CONFIG_DIR="$HOME/.config/luna"
# export LUNA_APPROVAL_STORE="$HOME/.config/luna/approvals.db"
# export LUNA_APPROVAL_TTL=10m
# export LUNA_APPROVAL_PROVIDER=fake
export LUNA_CLI_APPROVER_USERS="${LUNA_CLI_APPROVER_USERS:-$(id -u)}"

# --- Telegram (uncomment when LUNA_APPROVAL_PROVIDER includes telegram) ---
# export LUNA_TELEGRAM_BOT_TOKEN_FILE="$HOME/.config/luna/telegram-bot-token"
# export LUNA_TELEGRAM_APPROVER_USER_ID=123456789
# export LUNA_TELEGRAM_CHAT_ID=

